NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RPC_HTTP=https://api.mainnet-beta.solana.com

# Free project ID from https://cloud.reown.com (formerly WalletConnect
# Cloud) — enables the WalletConnect option in the connect menu, which lets
# any mobile wallet (Trust, Bitget, Rainbow, etc.) pair via QR code without
# needing a browser extension. Left unset, WalletConnect is simply omitted
# from the list — every other adapter still works.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
