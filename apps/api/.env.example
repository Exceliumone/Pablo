# Server
PORT=4000
NODE_ENV=development

# Data
DATABASE_URL=postgresql://pablo:pablo@localhost:5432/pablo?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Solana
RPC_HTTP=https://api.mainnet-beta.solana.com
TREASURY_WALLET_ADDRESS=

# engine-bridge (per-user executor base, orchestrator fills the rest at runtime)
ENGINE_BRIDGE_INTERNAL_TOKEN=change-me
