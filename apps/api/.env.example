# Server
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# Data
DATABASE_URL=postgresql://pablo:pablo@localhost:5432/pablo?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Scope of the httpOnly refresh cookie — must match the path the BROWSER
# sees, not this app's own route prefix. Direct access (no reverse proxy,
# or a proxy that forwards /auth/* unchanged) needs the default /auth.
# Behind a reverse proxy that strips a path prefix before forwarding
# (e.g. Nginx `location /api/ { proxy_pass http://127.0.0.1:4000/; }`,
# so the public path is /api/auth/verify but this app only ever sees
# /auth/verify), set this to that public prefix instead, e.g. /api/auth —
# otherwise the browser will never send the cookie back and
# POST /auth/refresh will silently fail on every page reload.
AUTH_COOKIE_PATH=/auth

# Solana
RPC_HTTP=https://api.mainnet-beta.solana.com

# engine-bridge orchestrator
ENGINE_BRIDGE_INTERNAL_TOKEN=change-me
ENGINE_BRIDGE_URL=http://localhost:8090

# Platform-wide chain infra handed to each executor at spawn time — not
# admin-editable (unlike PlatformConfig), these are ops credentials.
YELLOWSTONE_GRPC_HTTP=
YELLOWSTONE_GRPC_TOKEN=
ZERO_SLOT_URL=

# Envelope key for trading-wallet secret keys — AES-256-GCM, 32 bytes,
# base64. Generate your own, never reuse this file's value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This is a placeholder for real KMS/Vault — see src/lib/wallet-crypto.ts.
# Losing or leaking this key exposes every custodial trading wallet's
# private key, and rotating it after the fact requires re-encrypting every
# stored TradingWallet row — generate it once, keep it out of git, and back
# it up somewhere your secrets manager controls.
WALLET_ENCRYPTION_KEY=change-me-generate-a-real-32-byte-base64-key

# PlatformConfig bootstrap defaults (only used to seed the DB row once —
# after that, edit these from the admin API, not here)
TREASURY_WALLET_ADDRESS=
PABLO_MINT_ADDRESS=
MIN_HOLDER_TOKENS=1000000
SUBSCRIPTION_PRICE_USD=10
SUBSCRIPTION_DURATION_DAYS=30
GRACE_PERIOD_DAYS=3

# Wallet addresses auto-promoted to ADMIN on their first login (comma-separated)
ADMIN_WALLET_ADDRESSES=
