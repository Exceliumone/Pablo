# engine-bridge orchestrator (src/main.rs) — the only process apps/api
# talks to. Binds 0.0.0.0:$ENGINE_BRIDGE_PORT (default 8090).
#
# Must match apps/api/.env's ENGINE_BRIDGE_INTERNAL_TOKEN exactly — this is
# the Bearer token apps/api sends on every /internal/executors/* call.
ENGINE_BRIDGE_INTERNAL_TOKEN=change-me
REDIS_URL=redis://localhost:6379
ENGINE_BRIDGE_PORT=8090

# scanner (src/bin/scanner.rs) — the shared, singleton detection process.
# Not read by engine-bridge itself; only needed if you're also running
# scanner from this same .env file (see scripts/run-scanner.sh).
#
# Runs on standard Solana JSON-RPC only (logsSubscribe + getTransaction) —
# by design, there is no paid-gRPC-provider mode. Works against any
# provider's free or paid RPC+WS tier; defaulted below to Solana's own
# public RPC — free, no account/API key needed, but rate-limited (see
# solana.com/docs/rpc/http, "Public RPC endpoints": a single method like
# getTransaction is capped at 40 requests/10s, concurrent connections per
# IP at 40). Swap these two for a different provider's endpoint if you
# ever need more throughput — no code change required either way.
RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Caps how many getTransaction requests/sec the scanner dispatches — keep
# this safely under your provider's actual RPS ceiling. The default below
# is tuned for the public RPC endpoint above (well under its documented 40
# requests/10s per-method ceiling, leaving headroom for the 3
# logsSubscribe calls and anything else sharing the same IP); raise it if
# you switch to a higher-limit provider. Getting this wrong doesn't just
# throttle getTransaction — most providers meter HTTP and WSS against one
# shared budget, so exceeding it also starves out logsSubscribe's own
# reconnect attempts (surfaces as e.g. a "-32005 RPS limit" error on
# logsSubscribe itself, not just on getTransaction — Chainstack's error
# code for this, but the same failure mode applies to any RPS-limited
# provider).
SCANNER_MAX_RPC_RPS=2

# executor is NOT started from this file or these scripts — engine-bridge
# spawns one per active subscriber itself, at trade-start time, passing its
# full config (wallet key, settings, RPC endpoint) as a JSON blob via the
# EXECUTOR_CONFIG_JSON env var of that specific child process. See apps/api's
# POST /bot/start -> engine-bridge's POST /internal/executors/:userId/start.
