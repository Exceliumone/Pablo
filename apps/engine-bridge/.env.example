# engine-bridge orchestrator (src/main.rs) — the only process apps/api
# talks to. Binds 0.0.0.0:$ENGINE_BRIDGE_PORT (default 8090).
#
# Must match apps/api/.env's ENGINE_BRIDGE_INTERNAL_TOKEN exactly — this is
# the Bearer token apps/api sends on every /internal/executors/* call.
ENGINE_BRIDGE_INTERNAL_TOKEN=change-me
REDIS_URL=redis://localhost:6379
ENGINE_BRIDGE_PORT=8090

# scanner (src/bin/scanner.rs) — the shared, singleton detection process.
# Not read by engine-bridge itself; only needed if you're also running
# scanner from this same .env file (see scripts/run-scanner.sh).
#
# Production mode: set these two, scanner subscribes via Yellowstone gRPC.
# scanner panics on boot if either is set but empty — there is no default.
YELLOWSTONE_GRPC_HTTP=
YELLOWSTONE_GRPC_TOKEN=

# Development mode: leave YELLOWSTONE_GRPC_HTTP unset/empty and set these
# two instead — scanner falls back to standard Solana JSON-RPC
# (logsSubscribe + getTransaction) so this can run without the Yellowstone
# gRPC add-on. Materially higher latency and RPC-quota-hungry — see
# scanner.rs's module doc comment before using this against real capital.
#
# Defaulted below to Solana's own public RPC — free, no account/API key
# needed, but rate-limited (see solana.com/docs/rpc/http, "Public RPC
# endpoints": a single method like getTransaction is capped at 40
# requests/10s, concurrent connections per IP at 40). This is meant as a
# temporary, $0 way to validate the full scanner -> executor pipeline
# works at all before committing to a paid provider (Chainstack or
# otherwise) — swap these two for a paid endpoint's URLs whenever you're
# ready for that, no code change needed on that side.
RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Caps how many getTransaction requests/sec dev mode dispatches — keep this
# safely under your plan's actual RPS ceiling. The default below is tuned
# for the public RPC endpoint above (well under its documented 40
# requests/10s per-method ceiling, leaving headroom for the 3
# logsSubscribe calls and anything else sharing the same IP); raise it if
# you switch to a paid, higher-limit provider. Getting this wrong doesn't
# just throttle getTransaction — most providers meter HTTP and WSS against
# one shared budget, so exceeding it also starves out logsSubscribe's own
# reconnect attempts (surfaces as e.g. Chainstack's "-32005 RPS limit"
# error on logsSubscribe itself, not just on getTransaction).
SCANNER_MAX_RPC_RPS=2

# executor is NOT started from this file or these scripts — engine-bridge
# spawns one per active subscriber itself, at trade-start time, passing its
# full config (wallet key, settings, RPC/gRPC endpoints) as a JSON blob via
# the EXECUTOR_CONFIG_JSON env var of that specific child process. See
# apps/api's POST /bot/start -> engine-bridge's POST /internal/executors/:userId/start.
